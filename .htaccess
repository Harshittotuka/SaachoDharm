# Enable mod_rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce a single host/protocol for canonical URLs
  # Use X-Forwarded-Proto for Hostinger/CyberPanel (SSL terminated at proxy)
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://saachodharm.com%{REQUEST_URI} [R=301,L]

  # Canonicalize old lyric URLs to clean English-only path
  RewriteCond %{QUERY_STRING} (^|&)bhajan=([^&]+) [NC]
  RewriteRule ^(?:bhajan-lyrics|jain-bhajan-lyrics)(?:\.html)?$ /bhajan/%2? [R=301,L,NE,NC]

  # Canonicalize legacy lyric query URL to clean path
  RewriteCond %{QUERY_STRING} (^|&)bhajan=([^&]+) [NC]
  RewriteRule ^jain-bhajan-lyrics$ /bhajan/%2? [R=301,L,NE,NC]

  # Canonicalize id query URL to clean path
  RewriteCond %{QUERY_STRING} (^|&)id=([^&]+) [NC]
  RewriteRule ^jain-bhajan-lyrics(?:\.html)?$ /bhajan/%2? [R=301,L,NE,NC]

  # Canonicalize tirth detail query URL to clean path
  RewriteCond %{QUERY_STRING} (^|&)id=([^&]+) [NC]
  RewriteRule ^tirth-sthal-detail(?:\.html)?$ /tirth/%2? [R=301,L,NE,NC]

  # Pretty dynamic routes (internally served by existing HTML files)
  # Use a unique marker (bhajan_slug) that JavaScript can reliably detect
  RewriteRule ^bhajan/([^/]+)/?$ /jain-bhajan-lyrics.html?bhajan_slug=$1 [L,NC,QSA]
  RewriteRule ^tirth/([^/]+)/?$ /tirth-sthal-detail.html?tirth_id=$1 [L,NC,QSA]

  # Redirect /index.html to /
  RewriteRule ^index\.html$ / [R=301,L,NC]

  # Redirect .html URLs to extensionless canonical URLs
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html(?:[\s?]|$) [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # Legacy URL compatibility: old bhajan route now points to jain-bhajan-lyrics
  RewriteRule ^bhajan-lyrics(?:\.html)?$ /jain-bhajan-lyrics [R=301,L,NC]
  
  # Remove .html extension from URLs
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/x-httpd-php
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/json
</IfModule>

# Set Cache-Control headers
<IfModule mod_headers.c>
  # Cache HTML for 1 week
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=604800, public"
  </FilesMatch>
  
  # Cache CSS, JS, images for 1 month
  <FilesMatch "\.(css|js|gif|jpg|jpeg|png|ico|woff|woff2|svg)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  
  # Don't cache JSON files
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Disable directory listing
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Security headers for SEO
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Add MIME types
<IfModule mod_mime.c>
  AddType application/json json
  AddType application/xml xml
</IfModule>
